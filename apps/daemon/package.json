{
  "name": "@school-buddy/daemon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "start": "bun run src/cli.ts",
    "setup": "bun run src/cli.ts setup",
    "compile": "bun build src/cli.ts --compile --outfile dist/school-buddy"
  },
  "dependencies": {
    "@school-buddy/shared": "workspace:*",
    "effect": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/ai-openai": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0"
  }
}
