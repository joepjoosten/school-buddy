<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.schoolbuddy.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BUN__</string>
    <string>run</string>
    <string>src/cli.ts</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/apps/daemon</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.school-buddy/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.school-buddy/daemon.log</string>
</dict>
</plist>
